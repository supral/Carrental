# Database
# PostgreSQL 18 on this machine listens on port 5433 (not 5432)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5433/nb_automotive?schema=public"

# Auth.js — required on Vercel for admin login
# Generate AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-random-secret-in-production"
# Site root only — no path (NOT /admin/login). Production example:
# AUTH_URL="https://carrental-tan.vercel.app"
AUTH_URL="http://localhost:3001"

# Google Maps (Places Autocomplete for rental pickup/drop-off)
# Enable "Maps JavaScript API" and "Places API" in Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Stripe (rental booking payments — use sk_test_ / pk_test_ for sandbox)
# Set BYPASS_STRIPE_PAYMENT=true to confirm bookings immediately without Stripe
BYPASS_STRIPE_PAYMENT=false
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Production: set to your live site URL — used for booking success redirects and emails
# On Vercel this auto-detects from VERCEL_URL if unset, but set explicitly for custom domains
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Cron (release expired vehicle checkout reservations every minute)
CRON_SECRET=

# Rental pricing
RENTAL_TAX_RATE=0.05
NEXT_PUBLIC_RENTAL_TAX_RATE=0.05

# Email (Zoho SMTP — sale/rental notifications, lead alerts)
# Port 465 = SSL (set SMTP_SECURE=true), Port 587 = STARTTLS (default)
SMTP_HOST=smtp.zoho.com.au
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=reservations@everestcarrental.com
SMTP_PASS=
SMTP_FROM="Everest Car Rental <reservations@everestcarrental.com>"
