# Database
# PostgreSQL 18 on this machine listens on port 5433 (not 5432)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5433/nb_automotive?schema=public"

# Auth.js
AUTH_SECRET="change-this-to-a-random-secret-in-production"
AUTH_URL="http://localhost:3000"

# Google Maps (Places Autocomplete for rental pickup/drop-off)
# Enable "Maps JavaScript API" and "Places API" in Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Stripe (rental booking payments)
# Leave STRIPE_SECRET_KEY empty to skip payment in development (booking confirms immediately)
# Or set BYPASS_STRIPE_PAYMENT=true to skip even when Stripe keys are present
BYPASS_STRIPE_PAYMENT=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron (release expired vehicle checkout reservations every minute)
CRON_SECRET=

# Rental pricing
RENTAL_TAX_RATE=0.05
NEXT_PUBLIC_RENTAL_TAX_RATE=0.05

# Email (sale booking notifications & meeting invites)
# Without SMTP, emails are logged to the server console in development
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NB Automotive <noreply@nbautomotive.com.au>"
